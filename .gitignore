/dataset/raw/
/outputs/
/models/pretrained/
/models/checkpoints/
/models/exported/

# Python environments, bytecode, and tooling caches.
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
*.egg-info/
/build/
/dist/

# Notebook checkpoints and local experiment-tracker data.
.ipynb_checkpoints/
/wandb/
/mlruns/

# Local environment variables; retain shareable templates.
.env
.env.*
!.env.example
!.env.template

